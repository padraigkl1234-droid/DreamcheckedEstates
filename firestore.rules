rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers ---------------------------------------------------------
    function isMasterAdmin() {
      return request.auth != null &&
        request.auth.token.email == "padraigkl1234@gmail.com" &&
        request.auth.token.email_verified == true;
    }
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    // Default to 'member' / '' when the field is absent, so users who predate
    // the rank feature don't error out (a missing key would fail the rule).
    function myRank() {
      return request.auth != null ? myProfile().get('rank', 'member') : 'member';
    }
    function myTeam() {
      return request.auth != null ? myProfile().get('teamId', '') : '';
    }
    // A commander of the given team (chain-of-command oversight).
    function isCommanderOf(teamId) {
      return request.auth != null && myRank() == 'commander' && myTeam() == teamId;
    }
    // Signed in AND has actually joined a team — as opposed to mid-onboarding,
    // sitting on the "enter a referral code" screen. Joining itself never
    // needs to read team-scoped data (see AppGate, which only calls the join
    // API), so this is a safe bar for "may see shared team data".
    function amTeamMember() {
      return request.auth != null && myTeam() != '';
    }
    // True when `teamId` is this caller's own (non-empty) team — the shape
    // every team-scoped collection's documents carry.
    function inMyTeam(teamId) {
      return amTeamMember() && teamId == myTeam();
    }

    // ---- Collections -----------------------------------------------------

    // Shared team show board.
    match /shows/{showId} {
      allow read, update, delete: if isMasterAdmin() || inMyTeam(resource.data.teamId);
      allow create: if isMasterAdmin() || inMyTeam(request.resource.data.teamId);
    }

    // User profiles. Reading your OWN doc is always allowed (so a brand-new,
    // not-yet-joined user can load their profile on the join screen); reading
    // the WHOLE roster (the "assign to" pickers, team page, automations)
    // needs an actual team membership, so a stranger who merely signed in
    // with a Google account can't browse the staff list and every email
    // address on it. `teamIds` is the list of teams you have actually joined,
    // and the only set the team switcher will move you between — so it's
    // locked exactly like teamId: a client able to append to it could walk
    // into any team without its referral code.
    // Rank, team membership and blocked status are
    // infrastructure set only by the Admin SDK (api/teams, api/admin/users),
    // which bypasses these rules entirely — a client can never grant itself
    // any of those fields, and `email` must match the signed-in Google
    // account so nobody can claim a teammate's address (e.g. to hijack Estate
    // Request "Assigned To" routing, which matches by email).
    match /users/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isMasterAdmin() || amTeamMember());
      allow list: if isMasterAdmin() || amTeamMember();
      allow create: if request.auth != null && request.auth.uid == uid &&
        !('rank' in request.resource.data) &&
        !('teamId' in request.resource.data) &&
        !('teamIds' in request.resource.data) &&
        !('blocked' in request.resource.data) &&
        !('fireMarshal' in request.resource.data) &&
        !('firstAider' in request.resource.data) &&
        request.resource.data.get('email', request.auth.token.email) == request.auth.token.email;
      // Self-edit: everything except the fields locked to admin/commander
      // control (fireMarshal/firstAider join that list — a member can't
      // self-assign a safety badge, only a commander can grant one).
      allow update: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.get('rank', null) == resource.data.get('rank', null) &&
        request.resource.data.get('teamId', null) == resource.data.get('teamId', null) &&
        request.resource.data.get('teamIds', []) == resource.data.get('teamIds', []) &&
        request.resource.data.get('blocked', false) == resource.data.get('blocked', false) &&
        request.resource.data.get('fireMarshal', false) == resource.data.get('fireMarshal', false) &&
        request.resource.data.get('firstAider', false) == resource.data.get('firstAider', false) &&
        request.resource.data.get('email', request.auth.token.email) == request.auth.token.email;
      // A team commander (or master) may flip a teammate's Fire Marshal /
      // First Aider badges on the Team page — and ONLY those two fields on
      // that teammate's doc, nothing else (hasOnly guarantees teamId, rank,
      // blocked etc. all stay put, so this can't be used to touch anything
      // the self-edit rule above already locks down).
      allow update: if request.auth != null &&
        (isMasterAdmin() || isCommanderOf(resource.data.teamId)) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fireMarshal', 'firstAider']);
      allow delete: if false;
    }

    // Shared tasks. Private to whoever's on them: visible (and editable/
    // deletable) only to participants and to anyone the task is currently
    // offered to (a task can be offered to several people at once, each
    // awaiting their own accept), plus the master admin as a safety net.
    // A team commander gets NO automatic access to another member's tasks —
    // only actual participants can touch a task.
    match /tasks/{taskId} {
      function canAccessTask() {
        return request.auth != null && (
          request.auth.uid in resource.data.participants ||
          request.auth.uid in resource.data.get('pendingUids', []) ||
          isMasterAdmin()
        );
      }
      allow read, update, delete: if canAccessTask();
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
    }

    // Incident / near-miss reports. Deliberately NOT team-wide like the
    // reports below — locked to the master admin, whoever it's assigned to,
    // and (if not filed anonymously) the person who filed it. Nobody else,
    // not even a commander, sees a report by default; only master assigns
    // it or changes its status. Anyone on a team may file one, any rank —
    // safety reporting shouldn't be gated by chain of command.
    match /incidentReports/{id} {
      allow read: if request.auth != null && (
        isMasterAdmin() ||
        resource.data.assignedUid == request.auth.uid ||
        (resource.data.anonymous == false && resource.data.createdBy == request.auth.uid)
      );
      allow create: if request.auth != null &&
        amTeamMember() &&
        request.resource.data.teamId == myTeam() &&
        request.resource.data.status == 'submitted' &&
        request.resource.data.anonymous is bool &&
        !('assignedUid' in request.resource.data) &&
        !('assignedName' in request.resource.data) &&
        !('assignedAt' in request.resource.data) &&
        !('investigationNotes' in request.resource.data) &&
        (
          request.resource.data.anonymous == true
            ? !('createdBy' in request.resource.data) && !('createdByName' in request.resource.data)
            : request.resource.data.createdBy == request.auth.uid
        );
      // Only master assigns a report, changes its status, or adds
      // investigation notes — the person it's assigned to can read but not
      // edit (see the class comment above).
      allow update, delete: if isMasterAdmin();
    }

    // Authored reports. "team" reports are visible team-wide; "command" reports
    // only to their author, team commanders and the master. Viewers can't file.
    match /reports/{reportId} {
      allow read: if request.auth != null && (
        resource.data.createdBy == request.auth.uid ||
        isMasterAdmin() ||
        (resource.data.teamId == myTeam() &&
          (resource.data.visibility == 'team' || isCommanderOf(resource.data.teamId)))
      );
      allow create: if request.auth != null &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.teamId == myTeam() &&
        myRank() != 'viewer' &&
        request.resource.data.title is string &&
        request.resource.data.visibility in ['command', 'team'];
      allow update, delete: if request.auth != null && (
        resource.data.createdBy == request.auth.uid ||
        isMasterAdmin() ||
        isCommanderOf(resource.data.teamId)
      );
    }

    // Each user's private compliance/diary state.
    match /jarvisState/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Team-scoped shared forms.
    match /checklistForms/{id} {
      allow read, update, delete: if isMasterAdmin() || inMyTeam(resource.data.teamId);
      allow create: if isMasterAdmin() || inMyTeam(request.resource.data.teamId);
    }
    match /auditForms/{id} {
      allow read, update, delete: if isMasterAdmin() || inMyTeam(resource.data.teamId);
      allow create: if isMasterAdmin() || inMyTeam(request.resource.data.teamId);
    }
    // Inspection checklists (see /inspections). Running one files a report, so
    // the results themselves are governed by the /reports rules above. Master
    // gets an unscoped bypass — the automations console picks a checklist
    // from every team's list, not just its own.
    match /inspectionTemplates/{id} {
      allow read, update, delete: if isMasterAdmin() || inMyTeam(resource.data.teamId);
      allow create: if isMasterAdmin() || inMyTeam(request.resource.data.teamId);
    }

    // Site assets — safety-equipment pins on a zone's floor plan (see
    // /site-map/ballroom).
    match /assets/{id} {
      allow read, update, delete: if isMasterAdmin() || inMyTeam(resource.data.teamId);
      allow create: if isMasterAdmin() || inMyTeam(request.resource.data.teamId);
    }

    // Team docs. Referral codes live here, and a code is the only thing
    // gating who can join a team, so — like the roster — only your own team
    // (or master) can be read, not every team's document.
    match /teams/{teamId} {
      allow read: if isMasterAdmin() || teamId == myTeam();
    }

    // Areas marked out of use for a day or a date range, drawn on the Site
    // Status board (/site-status). Read by the whole team — the entire point
    // is that everyone on site can see what's shut — but only a commander of
    // that team (or master) may close an area or reopen it. `createdBy` is
    // pinned to the caller so a closure can always be traced back to whoever
    // set it. The client query filters on teamId, mirroring the read rule.
    match /siteClosures/{id} {
      allow read: if isMasterAdmin() || inMyTeam(resource.data.teamId);
      allow create: if isMasterAdmin() ||
        (isCommanderOf(request.resource.data.teamId) &&
          request.resource.data.createdBy == request.auth.uid);
      // Reopening is a delete. An update may not move a closure to another
      // team or disown it.
      allow update: if isMasterAdmin() ||
        (isCommanderOf(resource.data.teamId) &&
          request.resource.data.teamId == resource.data.teamId &&
          request.resource.data.createdBy == resource.data.createdBy);
      allow delete: if isMasterAdmin() || isCommanderOf(resource.data.teamId);
    }

    // The Project Board (/project-board) — a team-wide pin board of
    // reminders, project notes and Capex ideas. Everyone on the team reads
    // it. A note belongs to whoever pinned it: only they (or a commander)
    // may change its words or take it down. Everyone else may move it, back
    // it, attach a photo and mark it as having become a task — and nothing
    // else, which the field list below enforces rather than trusting the UI.
    match /boardPosts/{id} {
      allow read: if isMasterAdmin() || inMyTeam(resource.data.teamId);
      allow create: if (isMasterAdmin() || inMyTeam(request.resource.data.teamId)) &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.title is string;
      // The owner (or a commander / master) may edit the note itself, but
      // can't hand it to someone else or move it to another team.
      allow update: if (isMasterAdmin() || isCommanderOf(resource.data.teamId) ||
          (inMyTeam(resource.data.teamId) && resource.data.ownerUid == request.auth.uid)) &&
        request.resource.data.teamId == resource.data.teamId &&
        request.resource.data.ownerUid == resource.data.ownerUid;
      // Anyone on the team: the shared, collaborative bits only.
      allow update: if inMyTeam(resource.data.teamId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['x', 'y', 'z', 'votes', 'photos', 'taskId', 'taskByName', 'taskAt', 'updatedAt']);
      allow delete: if isMasterAdmin() || isCommanderOf(resource.data.teamId) ||
        (inMyTeam(resource.data.teamId) && resource.data.ownerUid == request.auth.uid);
    }

    // Comments on a board note. Team-wide readable, never edited after the
    // fact — a thread people can rewrite isn't a record of the discussion.
    // Deleting is for the author, a commander, or master (who also tidies up
    // a thread when its note comes down).
    match /boardComments/{id} {
      allow read: if isMasterAdmin() || inMyTeam(resource.data.teamId);
      allow create: if inMyTeam(request.resource.data.teamId) &&
        request.resource.data.byUid == request.auth.uid &&
        request.resource.data.text is string;
      allow update: if false;
      allow delete: if isMasterAdmin() || isCommanderOf(resource.data.teamId) ||
        (inMyTeam(resource.data.teamId) && resource.data.byUid == request.auth.uid);
    }

    // Assigning a piece of work (see /assignments) to a specific person, for
    // a date or a repeating schedule, with an explicit accept/decline —
    // private to the two parties, like a task, not team-wide visible.
    match /assignments/{id} {
      function isAssigner() { return resource.data.assignedByUid == request.auth.uid; }
      function isAssignee() { return resource.data.assigneeUid == request.auth.uid; }
      allow read: if request.auth != null && (isMasterAdmin() || isAssigner() || isAssignee());
      allow create: if request.auth != null &&
        amTeamMember() &&
        request.resource.data.teamId == myTeam() &&
        request.resource.data.assignedByUid == request.auth.uid &&
        request.resource.data.assigneeUid != request.auth.uid &&
        request.resource.data.status == 'pending';
      // Only the assignee may accept/decline their own offer, and only that
      // — nothing else on the document may change from here. The assigner
      // may retract a still-pending offer by deleting it.
      allow update: if request.auth != null && (
        isMasterAdmin() ||
        (isAssignee() &&
          resource.data.status == 'pending' &&
          request.resource.data.status in ['accepted', 'declined'] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt']))
      );
      allow delete: if request.auth != null && (isMasterAdmin() || (isAssigner() && resource.data.status == 'pending'));
    }

    // Scheduled automations (e.g. the weekly email report). Master-only —
    // this is infrastructure configuration, not per-user data.
    match /automations/{id} {
      allow read, write: if isMasterAdmin();
    }

    // Integration settings (e.g. who estate requests get offered to). Written
    // from the master console; the webhook itself reads it via the Admin SDK,
    // which bypasses these rules.
    match /config/{id} {
      allow read, write: if isMasterAdmin();
    }

    // ---- Hotel Operations module ----------------------------------------
    // Only teams switched to the hotel module ever write these (see
    // src/lib/hotel/types.ts for the model). Every document carries teamId
    // and every rule requires it to be the caller's own team, so one hotel
    // can never read or write another's data — tests/hotel-rules.test.ts
    // proves it against the emulator.
    //
    // Hotel roles are separate from the estates rank ladder: they live in
    // hotelStaff/{teamId}_{uid} and only a hotel manager can set them. A team
    // commander (and the master) is always treated as a hotel manager so a
    // freshly-converted team is never locked out of its own settings.
    function myHotelStaffPath() {
      return /databases/$(database)/documents/hotelStaff/$(myTeam() + '_' + request.auth.uid);
    }
    function hasHotelRole(teamId, roles) {
      return inMyTeam(teamId) &&
        exists(myHotelStaffPath()) &&
        get(myHotelStaffPath()).data.get('active', true) == true &&
        get(myHotelStaffPath()).data.role in roles;
    }
    function isHotelManager(teamId) {
      return isMasterAdmin() || isCommanderOf(teamId) || hasHotelRole(teamId, ['manager']);
    }
    // Manager or maintenance: the fault queue and compliance.
    function isHotelMaint(teamId) {
      return isHotelManager(teamId) || hasHotelRole(teamId, ['maintenance']);
    }
    // Anyone with a hotel role in this team.
    function isHotelStaff(teamId) {
      return isHotelManager(teamId) || hasHotelRole(teamId, ['housekeeper', 'maintenance']);
    }
    function teamUnchanged() {
      return request.resource.data.teamId == resource.data.teamId;
    }

    match /hotelStaff/{id} {
      // Your own staff doc is always readable (the hub checks it on load).
      allow get: if request.auth != null && id == myTeam() + '_' + request.auth.uid;
      allow read: if isHotelStaff(resource.data.teamId);
      // A manager sets roles, only for people actually on their team, and
      // the doc id is pinned to teamId_uid so a role can't be filed twice.
      allow create, update: if isHotelManager(request.resource.data.teamId) &&
        id == request.resource.data.teamId + '_' + request.resource.data.uid &&
        request.resource.data.role in ['manager', 'housekeeper', 'maintenance'] &&
        get(/databases/$(database)/documents/users/$(request.resource.data.uid)).data.get('teamId', '') == request.resource.data.teamId &&
        (resource == null || teamUnchanged());
      allow delete: if false;
    }

    match /hotelSettings/{teamId} {
      allow read: if isHotelStaff(teamId);
      allow create, update: if isHotelManager(teamId) && request.resource.data.teamId == teamId;
      allow delete: if false;
    }

    match /hotelRooms/{id} {
      allow read: if isHotelStaff(resource.data.teamId);
      allow create: if isHotelManager(request.resource.data.teamId);
      allow delete: if isHotelManager(resource.data.teamId);
      // Managers edit anything. Other staff may only move a room's status
      // (start/finish a clean, mark it out of order, return it to dirty) —
      // never to "inspected", which is the manager's sign-off.
      allow update: if teamUnchanged() && (
        isHotelManager(resource.data.teamId) ||
        (isHotelStaff(resource.data.teamId) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'statusAt', 'statusBy', 'statusByName', 'lastCleanedAt']) &&
          request.resource.data.status in ['dirty', 'in_progress', 'clean', 'out_of_order'] &&
          request.resource.data.statusBy == request.auth.uid)
      );
    }

    // Append-only status history.
    match /hotelRoomEvents/{id} {
      allow read: if isHotelStaff(resource.data.teamId);
      allow create: if isHotelStaff(request.resource.data.teamId) && request.resource.data.byUid == request.auth.uid;
      allow update, delete: if false;
    }

    // A room's job for the day. Housekeepers see and work only their own.
    match /hotelAssignments/{id} {
      allow read: if isHotelManager(resource.data.teamId) ||
        (isHotelStaff(resource.data.teamId) && resource.data.assigneeUid == request.auth.uid);
      allow create: if isHotelManager(request.resource.data.teamId) &&
        id == request.resource.data.teamId + '_' + request.resource.data.date + '_' + request.resource.data.roomId;
      allow delete: if isHotelManager(resource.data.teamId);
      allow update: if teamUnchanged() && (
        isHotelManager(resource.data.teamId) ||
        (isHotelStaff(resource.data.teamId) &&
          resource.data.assigneeUid == request.auth.uid &&
          request.resource.data.updatedBy == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['outcome', 'startedAt', 'finishedAt', 'note', 'checklist', 'updatedAt', 'updatedBy', 'updatedByName']))
      );
    }

    match /hotelChecklistTemplates/{id} {
      allow read: if isHotelStaff(resource.data.teamId);
      allow create, update: if isHotelManager(request.resource.data.teamId) &&
        id == request.resource.data.teamId + '_' + request.resource.data.cleanType &&
        (resource == null || teamUnchanged());
      allow delete: if isHotelManager(resource.data.teamId);
    }

    // Faults: anyone on staff can report one; the queue belongs to managers
    // and maintenance. A reporter can still see their own reports and attach
    // the photos their phone uploads once it's back online.
    match /hotelFaults/{id} {
      allow read: if isHotelMaint(resource.data.teamId) ||
        (isHotelStaff(resource.data.teamId) && resource.data.reportedBy == request.auth.uid);
      allow create: if isHotelStaff(request.resource.data.teamId) &&
        request.resource.data.reportedBy == request.auth.uid &&
        request.resource.data.status == 'open';
      allow update: if teamUnchanged() && (
        isHotelMaint(resource.data.teamId) ||
        (isHotelStaff(resource.data.teamId) &&
          resource.data.reportedBy == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photos', 'pendingPhotos', 'updatedAt']))
      );
      allow delete: if isHotelManager(resource.data.teamId);
    }

    // Append-only fault log.
    match /hotelFaultUpdates/{id} {
      allow read: if isHotelMaint(resource.data.teamId);
      allow create: if isHotelStaff(request.resource.data.teamId) && request.resource.data.byUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /hotelComplianceChecks/{id} {
      allow read: if isHotelMaint(resource.data.teamId);
      allow create: if isHotelManager(request.resource.data.teamId);
      allow delete: if isHotelManager(resource.data.teamId);
      // Maintenance completing a check may only roll its due date forward.
      allow update: if teamUnchanged() && (
        isHotelManager(resource.data.teamId) ||
        (isHotelMaint(resource.data.teamId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nextDue', 'lastDoneAt', 'lastResult']))
      );
    }

    // Append-only compliance log.
    match /hotelComplianceLogs/{id} {
      allow read: if isHotelMaint(resource.data.teamId);
      allow create: if isHotelMaint(request.resource.data.teamId) && request.resource.data.byUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Append-only settings/staff audit trail.
    match /hotelAudit/{id} {
      allow read: if isHotelManager(resource.data.teamId);
      allow create: if isHotelStaff(request.resource.data.teamId) && request.resource.data.byUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Connectivity probe.
    match /test/connection {
      allow read: if true;
    }
  }
}
